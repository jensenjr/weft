# ===========================================
# Weft Environment Configuration
# ===========================================
# For Docker / Coolify: copy this to .env and fill in the required values.
# All weft binaries (weft-api, orchestrator, node-runner) read from this file.

# ----- Required for Docker deployment -----

# PostgreSQL password (used by docker-compose for both postgres and weft-api)
POSTGRES_PASSWORD=changeme

# Secret key shared between weft-api and the dashboard for internal requests.
# Generate with: openssl rand -hex 32
INTERNAL_API_KEY=

# External origin of the dashboard (used by SvelteKit for CSRF protection).
# Example: https://app.yourdomain.com
ORIGIN=

# Comma-separated list of allowed CORS/auth origins (cloud mode).
# Example: https://app.yourdomain.com,https://extension.yourdomain.com
ALLOWED_ORIGINS=

# ----- API Keys -----
# Nodes fail gracefully with a clear error when the key is missing.

# OpenRouter — LLM nodes
# OPENROUTER_API_KEY=

# ElevenLabs — Speech-to-Text nodes
# ELEVENLABS_API_KEY=

# Tavily — Web Search nodes
# TAVILY_API_KEY=

# Apollo — Apollo Search/Enrich/Org Search nodes
# APOLLO_API_KEY=

# E2B — Python code execution nodes
# E2B_API_KEY=

# Discord — Discord trigger/nodes
# DISCORD_BOT_TOKEN=

# ----- Ports -----
# Ports exposed by docker-compose on the host.
# WEFT_API_PORT=3000
# DASHBOARD_PORT=80

# ----- URLs (optional) -----
# Public-facing URL of the weft-api, used for trigger webhook callbacks.
# Example: https://api.yourdomain.com
# API_BASE_URL=

# Public-facing URL of the dashboard, used in notification emails.
# Example: https://app.yourdomain.com
# DASHBOARD_URL=

# ----- Security: Credential Encryption -----
# AES-256-GCM key for encrypting trigger credentials at rest.
# Generate with: openssl rand -base64 32
# If not set, a development fallback is used (NOT secure for production).
# CREDENTIAL_ENCRYPTION_KEY=

# ----- Deployment Mode -----
# "cloud" = token validation, strict CORS, INTERNAL_API_KEY required
# "local" = relaxed auth for development
DEPLOYMENT_MODE=cloud

# ----- Logging -----
# RUST_LOG=info

# ----- Rate Limiting -----
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_RPS=200
# RATE_LIMIT_BURST=5000
